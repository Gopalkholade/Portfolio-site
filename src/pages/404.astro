---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - Not Found">
  <div class="py-24 text-center">
    <p class="font-mono text-accent text-sm mb-2">&gt; ERROR 404</p>
    <h1 class="text-3xl font-bold text-text-main mb-4">Target Resource Does Not Exist</h1>
    <a href="/" class="font-mono text-xs text-accent hover:underline">Return to index /</a>
  </div>
</Layout>