---
import type { Certification } from '../types';

interface Props {
  certifications: Certification[];
}

const { certifications } = Astro.props;
---
{certifications.length > 0 && (
  <section class="mb-16">
    <h2 class="text-xs font-mono tracking-widest text-text-dim uppercase mb-6 flex items-center gap-2">
      <span class="text-accent">&gt;</span> Verified Credentials & Certifications
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {certifications.map(cert => (
        <div class="p-4 rounded-lg border border-stroke bg-panel flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-[10px] text-accent uppercase tracking-wider">
                {cert.category === 'ai-ml' ? 'AI & ML' : 'Data Analytics'}
              </span>
              {cert.issueDate && (
                <span class="font-mono text-xs text-text-dim">{cert.issueDate}</span>
              )}
            </div>
            <h3 class="text-sm font-semibold text-text-main">{cert.title}</h3>
            <p class="text-xs font-mono text-text-dim mt-1">{cert.issuer}</p>
          </div>
          {cert.credentialUrl && (
            <div class="mt-3 pt-2 border-t border-stroke">
              <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-accent hover:underline inline-flex items-center gap-1">
                Verify Credential ↗
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
)}